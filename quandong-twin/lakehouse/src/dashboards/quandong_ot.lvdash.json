{
  "datasets": [
    {
      "name": "ds_incident_kpis",
      "displayName": "Incident KPIs (30 days)",
      "queryLines": [
        "SELECT count(*) AS incidents,\n",
        "  coalesce(sum(CASE WHEN max_severity = 'critical' THEN 1 ELSE 0 END), 0) AS critical_incidents,\n",
        "  coalesce(sum(CASE WHEN max_severity IN ('high', 'critical') AND coalesce(sensor_max_severity, 'none') IN ('none', 'low', 'medium') THEN 1 ELSE 0 END), 0) AS under_rated_by_sensor\n",
        "FROM gold_incidents\n",
        "WHERE first_seen_ts >= current_timestamp() - INTERVAL 30 DAYS"
      ]
    },
    {
      "name": "ds_incidents",
      "displayName": "Incidents",
      "queryLines": [
        "SELECT correlation_id, site_id, from_utc_timestamp(first_seen_ts, 'Australia/Adelaide') AS first_seen_local, from_utc_timestamp(last_seen_ts, 'Australia/Adelaide') AS last_seen_local,\n",
        "  max_severity, coalesce(sensor_max_severity, 'none') AS sensor_rated, finding_count,\n",
        "  array_join(rule_ids, ', ') AS rules, array_join(mitre_attack_ics_techniques, ', ') AS techniques,\n",
        "  array_join(affected_assets, ', ') AS assets, summary\n",
        "FROM gold_incidents\n",
        "ORDER BY first_seen_ts DESC"
      ]
    },
    {
      "name": "ds_findings",
      "displayName": "Findings timeline",
      "queryLines": [
        "SELECT from_utc_timestamp(detected_at, 'Australia/Adelaide') AS detected_local, site_id, rule_id, rule_name, severity,\n",
        "  mitre_attack_ics_technique, asset_id, correlation_id, description\n",
        "FROM gold_detections\n",
        "WHERE detected_at >= current_timestamp() - INTERVAL 30 DAYS"
      ]
    },
    {
      "name": "ds_site_health",
      "displayName": "Site health (7 days)",
      "queryLines": [
        "SELECT site_id, hour_local, uptime_pct, completeness_pct, good_data_pct, sensor_alerts, detections\n",
        "FROM gold_site_health\n",
        "WHERE hour_ts >= current_timestamp() - INTERVAL 7 DAYS"
      ]
    },
    {
      "name": "ds_site_health_24h",
      "displayName": "Site health (last 24 hours)",
      "queryLines": [
        "SELECT site_id, round(avg(uptime_pct), 1) AS uptime_pct, round(avg(completeness_pct), 1) AS completeness_pct,\n",
        "  sum(sensor_alerts) AS sensor_alerts, sum(detections) AS detections\n",
        "FROM gold_site_health\n",
        "WHERE hour_ts >= current_timestamp() - INTERVAL 24 HOURS\n",
        "GROUP BY site_id\n",
        "ORDER BY site_id"
      ]
    },
    {
      "name": "ds_chlorine",
      "displayName": "Chlorine residual with setpoint writes",
      "queryLines": [
        "SELECT from_utc_timestamp(timestamp_seconds(floor(unix_timestamp(event_ts) / 300) * 300), 'Australia/Adelaide') AS ts_local,\n",
        "  concat(site_id, ' residual') AS series, round(avg(value), 3) AS mg_per_l\n",
        "FROM silver_process_telemetry\n",
        "WHERE tag LIKE '%.CL2.DOSE_MGL' AND quality <> 'bad' AND event_ts >= current_timestamp() - INTERVAL 3 DAYS\n",
        "GROUP BY 1, 2\n",
        "UNION ALL\n",
        "SELECT from_utc_timestamp(event_ts, 'Australia/Adelaide') AS ts_local, concat(site_id, ' setpoint write') AS series, new_value AS mg_per_l\n",
        "FROM silver_protocol_events\n",
        "WHERE operation = 'write' AND register_or_point LIKE '%CL2.SETPOINT_MGL%' AND event_ts >= current_timestamp() - INTERVAL 3 DAYS"
      ]
    },
    {
      "name": "ds_pressure",
      "displayName": "Main pressure",
      "queryLines": [
        "SELECT from_utc_timestamp(timestamp_seconds(floor(unix_timestamp(event_ts) / 300) * 300), 'Australia/Adelaide') AS ts_local, site_id,\n",
        "  round(avg(value), 1) AS kpa\n",
        "FROM silver_process_telemetry\n",
        "WHERE tag LIKE '%.MAIN.PRESSURE_KPA' AND quality <> 'bad' AND event_ts >= current_timestamp() - INTERVAL 3 DAYS\n",
        "GROUP BY 1, 2"
      ]
    },
    {
      "name": "ds_setpoint_writes",
      "displayName": "Setpoint writes",
      "queryLines": [
        "SELECT from_utc_timestamp(event_ts, 'Australia/Adelaide') AS written_local, site_id, asset_id, coalesce(initiator_asset_id, initiator_ip) AS written_by,\n",
        "  user_context, old_value, new_value,\n",
        "  CASE WHEN new_value NOT BETWEEN 0.5 AND 1.5 THEN 'OUTSIDE SAFE BAND' ELSE 'within band' END AS assessment\n",
        "FROM silver_protocol_events\n",
        "WHERE operation = 'write' AND register_or_point LIKE '%SETPOINT%'\n",
        "ORDER BY event_ts DESC"
      ]
    },
    {
      "name": "ds_compliance",
      "displayName": "Compliance status",
      "queryLines": [
        "SELECT framework, control_id, control_name, status, attestation, maturity_level, previous_status,\n",
        "  status_changed, assessment_date, evidence_ref, notes\n",
        "FROM gold_compliance_status\n",
        "ORDER BY framework, control_id"
      ]
    },
    {
      "name": "ds_compliance_summary",
      "displayName": "Attestation summary",
      "queryLines": [
        "SELECT framework, attestation, count(*) AS controls\n",
        "FROM gold_compliance_status\n",
        "GROUP BY framework, attestation"
      ]
    },
    {
      "name": "ds_scorecard",
      "displayName": "Detection scorecard",
      "queryLines": [
        "SELECT scenario_name, site_id, from_utc_timestamp(scenario_start_ts, 'Australia/Adelaide') AS started_local, detected, rule_detection_rate,\n",
        "  time_to_detect_minutes, array_join(expected_rule_ids, ', ') AS expected_rules,\n",
        "  array_join(missed_rule_ids, ', ') AS missed_rules, array_join(correlation_ids, ', ') AS incidents\n",
        "FROM gold_detection_scorecard\n",
        "ORDER BY scenario_start_ts DESC"
      ]
    }
  ],
